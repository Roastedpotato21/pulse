{
  "agentName": "Pulse",
  "mode": "single-model",
  "model": {
    "provider": "openrouter",
    "fallbackProvider": "gemini",
    "name": "qwen/qwen3-coder",
    "temperature": 0.2,
    "maxTokens": 8192
  },
  "telemetry": {
    "maxSessionTokens": 100000,
    "maxSessionCost": 1.0
  },
  "sandbox": {
    "workspaceRoot": ".",
    "requirePermissionForReads": true,
    "requirePermissionForProjectActions": true,
    "allowWrites": false
  },
  "logging": {
    "actionLog": ".agent/logs/actions.jsonl",
    "telemetryLog": ".agent/logs/telemetry.jsonl"
  }
}
